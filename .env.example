APP_NAME="cms-service-lemon-acc"
APP_VERSION="1.0.0"
APP_DOMAIN="https://app.com"

# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/lemon2?schema=dev"


# Server
PORT=4002
NODE_ENV="development"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"
JWT_REFRESH_TOKEN_PREFIX="refresh_token:"

# secret key for encrypt
BE_SECRET_KEY="secret" 
BE_SALT_KEY="salt"